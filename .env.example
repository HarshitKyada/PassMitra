# PassMitra Configuration

# PORT: The port the server listens on (default 3000)
PORT="3000"

# TILE_SERVER_URL: OpenStreetMap raster tile URL template
TILE_SERVER_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# CRON_SECRET: Secret for authenticating scheduled maintenance jobs (/api/cron/*)
CRON_SECRET="your_secure_cron_secret"

# MSG91_AUTH_KEY: (Optional) MSG91 API key for production SMS OTP delivery (+91)
# In development, OTP is printed to server console and displayed in UI
MSG91_AUTH_KEY="your_msg91_auth_key"

# MONGODB_URI: (Optional) MongoDB Atlas connection string with GeoJSON 2dsphere support
# Defaults to high-performance in-memory MongoDB store if omitted
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/passmitra?retryWrites=true&w=majority"

# CLOUDINARY_URL: (Optional) Cloudinary image upload bucket
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: For Web Push notifications
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"

